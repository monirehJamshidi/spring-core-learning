<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Singleton bean - default scope -->
    <bean id="humanManager1"
          class="org.j2os.Manager1">
        <property name="dataBaseName" value="DB2" />
    </bean>

    <!-- Prototype bean -->
    <bean id="humanManager2"
          class="org.j2os.Manager1"
          scope="prototype">
        <property name="dataBaseName" value="POSTGRES"/>
    </bean>

    <!-- Eager initialization -->
    <bean id="humanManager3"
          class="org.j2os.Manager1"
          lazy-init="false" >
        <property name="dataBaseName" value="MONGO DB"/>
    </bean>

    <!-- Lazy initialization -->
    <bean id="humanManager4"
          class="org.j2os.Manager1"
          lazy-init="true" >
        <property name="dataBaseName" value="ELASTIC SEARCH"/>
    </bean>

    <!-- Constructor injection -->
    <bean id="humanManager5"
          class="org.j2os.Manager3"
          lazy-init="true">
        <constructor-arg index="0" value="My SQL" />
    </bean>

</beans>